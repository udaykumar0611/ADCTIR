# ADCTIR server configuration. Copy to .env and fill in.
#   cp .env.example .env && npm run start:ai
#
# .env is gitignored. Never commit real keys, and never put a key in any file
# under the extension side of this repo - the browser must not hold a key.

# --- AI/RAG explanation provider -------------------------------------------
# Leave every key blank to run the offline rules explainer (no network, no cost).
# Set exactly one key to enable model-written explanations.

# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (free models end in ":free"): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional overrides.
# ADCTIR_AI_PROVIDER picks a provider explicitly: gemini | openrouter | anthropic.
# Without it, the first key present wins, checked in that order.
#ADCTIR_AI_PROVIDER=gemini
# Defaults: gemini-flash-latest | meta-llama/llama-3.3-70b-instruct:free | claude-haiku-4-5
#ADCTIR_AI_MODEL=
#ADCTIR_AI_TIMEOUT_MS=20000
# Force the offline explainer even when a key is set.
#ADCTIR_AI_ENABLED=false

# --- Server ----------------------------------------------------------------
#ADCTIR_HOST=127.0.0.1
#ADCTIR_PORT=5001
#ADCTIR_ENABLE_RDAP=true
