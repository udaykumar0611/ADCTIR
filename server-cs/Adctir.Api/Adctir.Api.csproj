<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Adctir.Api</AssemblyName>
    <RootNamespace>Adctir.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The knowledge corpus is data the retriever reads at startup, so it must
         land next to the assembly in every build and publish output. -->
    <Content Include="Knowledge\**\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
